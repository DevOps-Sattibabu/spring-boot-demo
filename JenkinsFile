pipeline {
  agent any
  tools {
        maven 'MAVEN' // This name must match a Maven installation configured in Jenkins
    }
    environment {
        IMAGE_NAME = "localhost:5000/talkdesk-docker-repo/spring-boot-demo"
        IMAGE_TAG = "latest"
    }
    
  stages {
    stage('Checkout') {
      steps {
                git branch: 'main', url: 'https://github.com/DevOps-Sattibabu/spring-boot-demo.git'
      }
    }
    stage('Build and Test') {
      steps {
        
        // build the project and create a JAR file
        bat 'mvn clean package'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://localhost:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonar', variable: 'SONAR_AUTH_TOKEN')]) {
          bat '''mvn sonar:sonar -Dsonar.login=%SONAR_AUTH_TOKEN% -Dsonar.host.url=%SONAR_URL%'''
        }
      }
    }
    
    stage('Docker Build') {
            steps {
                bat '''
                docker build -t %IMAGE_NAME%:%IMAGE_TAG% .'''
            }
        }
        
    stage('Docker Login to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-docker-creds',
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASS'
                )]) {
                    bat """
                    echo %NEXUS_PASS% | docker login localhost:5000 -u %NEXUS_USER% --password-stdin
                    """
                }
            }
        }

        stage('Push to Nexus') {
            steps {
                bat '''docker push %IMAGE_NAME%:%IMAGE_TAG%'''
            }
        }
    
    
  }
}